new file mode 100644
index 0000000..d472843
--- /dev/null
+++ b/src/data/countries.ts
@@ -0,0 +1,53 @@
+export type CountryOption = {
+  code: string;
+  name: string;
+};
+
+// ISO 3166-1 alpha-2 codes. Names are generated by the browser's locale data,
+// avoiding an extra runtime dependency while keeping the list searchable in Arabic.
+const ISO_COUNTRY_CODES = `AD AE AF AG AI AL AM AO AQ AR AS AT AU AW AX AZ
+BA BB BD BE BF BG BH BI BJ BL BM BN BO BQ BR BS BT BV BW BY BZ
+CA CC CD CF CG CH CI CK CL CM CN CO CR CU CV CW CX CY CZ
+DE DJ DK DM DO DZ
+EC EE EG EH ER ES ET
+FI FJ FK FM FO FR
+GA GB GD GE GF GG GH GI GL GM GN GP GQ GR GS GT GU GW GY
+HK HM HN HR HT HU
+ID IE IL IM IN IO IQ IR IS IT
+JE JM JO JP
+KE KG KH KI KM KN KP KR KW KY KZ
+LA LB LC LI LK LR LS LT LU LV LY
+MA MC MD ME MF MG MH MK ML MM MN MO MP MQ MR MS MT MU MV MW MX MY MZ
+NA NC NE NF NG NI NL NO NP NR NU NZ
+OM
+PA PE PF PG PH PK PL PM PN PR PS PT PW PY
+QA
+RE RO RS RU RW
+SA SB SC SD SE SG SH SI SJ SK SL SM SN SO SR SS ST SV SX SY SZ
+TC TD TF TG TH TJ TK TL TM TN TO TR TT TV TW TZ
+UA UG UM US UY UZ
+VA VC VE VG VI VN VU
+WF WS
+YE YT
+ZA ZM ZW`
+  .trim()
+  .split(/\s+/);
+
+const arabicNames = new Intl.DisplayNames(["ar"], { type: "region" });
+const englishNames = new Intl.DisplayNames(["en"], { type: "region" });
+
+export const WORLD_COUNTRIES: CountryOption[] = ISO_COUNTRY_CODES.map((code) => ({
+  code,
+  name: arabicNames.of(code) ?? englishNames.of(code) ?? code,
+})).sort((a, b) => a.name.localeCompare(b.name, "ar"));
+
+export function getCountryName(code: string, locale = "ar") {
+  const country = WORLD_COUNTRIES.find((item) => item.code === code.toUpperCase());
+  if (country) return country.name;
+
+  try {
+    return new Intl.DisplayNames([locale], { type: "region" }).of(code.toUpperCase()) ?? code;
+  } catch {
+    return code;
+  }
+}
